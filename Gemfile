source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "jekyll-feed"
gem "jekyll-paginate"
gem "jekyll-seo-tag"

# Windows 平台需要 tzinfo-data
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# 提升 Windows 上 Jekyll 的监听性能
gem "wdm", "~> 0.1", :platforms => [:mingw, :x64_mingw, :mswin]
